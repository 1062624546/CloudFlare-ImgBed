+    async requestForwardSync(enabled) {
+        const requestId = ++this.forwardRequestId;
+        this.forwardBusy = true;
+        const url = '/api/manage/telegram/forward?channel=' + encodeURIComponent(this.editChannel.name);
+        try {
+            const options = enabled === undefined ? {} : {
+                method: 'POST',
+                headers: { 'Content-Type': 'application/json' },
+                body: JSON.stringify({ enabled })
+            };
+            const response = await fetchWithAuth(url, options);
+            const data = await response.json();
+            if (requestId !== this.forwardRequestId) return;
+            if (response.ok) {
+                this.forwardSync = data;
+            } else {
+                this.forwardSync = {
+                    ...this.forwardSync,
+                    conflict: data.error === 'webhookConflict',
+                    error: ['invalidChannel', 'webhookConflict', 'telegramUnavailable'].includes(data.error)
+                        ? data.error : 'updateFailed'
+                };
+            }
+        } catch {
+            if (requestId === this.forwardRequestId) this.forwardSync = { ...this.forwardSync, error: 'updateFailed' };
+        } finally {
+            if (requestId === this.forwardRequestId) this.forwardBusy = false;
+        }
+    },
+    updateForwardSync(enabled) {
+        return this.requestForwardSync(enabled);

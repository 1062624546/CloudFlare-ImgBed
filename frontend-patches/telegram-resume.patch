@@ -0,0 +1,79 @@
+import axios from '@/utils/axios'
+import { computeSha256 } from './sha256'
+
+function uploadRequest(url, action, signal, data, id, index) {
+    const endpoint = new URL(url, window.location.origin)
+    endpoint.searchParams.set('telegramResume', action)
+    if (id) endpoint.searchParams.set('uploadId', id)
+    if (index !== undefined) endpoint.searchParams.set('index', index)
+    return axios({
+        url: endpoint.pathname + endpoint.search,
+        method: action === 'status' ? 'get' : 'post',
+        data,
+        signal,
+        withAuthCode: true
+    })
+}
+
+async function uploadPart(url, signal, data, id, index) {
+    for (let attempt = 0; ; attempt++) {
+        try {
+            await uploadRequest(url, 'part', signal, data, id, index)
+            return
+        } catch (error) {
+            const status = error.response?.status
+            if (signal.aborted || attempt >= 3 || (status && status < 500 && status !== 429)) throw error
+            const retryAfter = Number(error.response?.headers?.['retry-after']) || 0
+            await new Promise(resolve => setTimeout(resolve, 1000 * Math.max(retryAfter, 2 ** attempt)))
+            signal.throwIfAborted()
+        }
+    }
+}
+
+export async function uploadResumableTelegramFile(url, file, signal, onProgress) {
+    const fingerprint = await computeSha256(file)
+    signal.throwIfAborted()
+    const key = 'telegramResume:' + JSON.stringify([url, file.name, file.size, file.type, fingerprint])
+    const saved = JSON.parse(localStorage.getItem(key) || 'null')
+    let session
+    let id = saved?.id
+
+    if (id && saved.expiresAt > Date.now()) {
+        try {
+            session = (await uploadRequest(url, 'status', signal, undefined, id)).data
+            if (session.fingerprint !== fingerprint) throw new Error('Upload fingerprint mismatch')
+        } catch (error) {
+            if (error.response?.status !== 410) throw error
+        }
+    }
+
+    if (!session) {
+        const form = new FormData()
+        form.append('originalFileName', file.name)
+        form.append('originalFileType', file.type)
+        form.append('size', String(file.size))
+        form.append('fingerprint', fingerprint)
+        session = (await uploadRequest(url, 'init', signal, form)).data
+        id = session.uploadId
+        localStorage.setItem(key, JSON.stringify({ id, expiresAt: session.expiresAt }))
+    }
+
+    const completed = new Set(session.completed || [])
+    const { chunkSize, totalChunks } = session
+    const sizeOf = index => Math.min(chunkSize, file.size - index * chunkSize)
+    let confirmed = [...completed].reduce((size, index) => size + sizeOf(index), 0)
+    const report = () => onProgress(Math.round(100 * confirmed / file.size))
+    report()
+
+    for (let index = 0; index < totalChunks; index++) {
+        if (completed.has(index)) continue
+        const start = index * chunkSize
+        await uploadPart(url, signal, file.slice(start, start + sizeOf(index), 'application/octet-stream'), id, index)
+        confirmed += sizeOf(index)
+        report()
+    }
+
+    const response = await uploadRequest(url, 'complete', signal, undefined, id)
+    localStorage.removeItem(key)
+    return response
+}
